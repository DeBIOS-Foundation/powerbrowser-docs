// markdownlint-cli2 config. Run from the repo root with no file arguments: "globs" and "ignores" set the full-set scope
// (every tracked Markdown file except .planning/, the .claude/skills symlink, and .claude/CLAUDE.md). The .claude/CLAUDE.md
// exclusion is temporary: it is hand-written, tracked, and has open findings (MD033, MD034, MD036) that need a user decision
// before it can be linted. The .prompts/project-info.prompttemplate file is not Markdown and is not linted here.
//   nix shell nixpkgs#markdownlint-cli2 -c markdownlint-cli2
{
  "config": {
    "default": true,
    // MD013: stamps, identifiers and table rows are long by design.
    "MD013": false,
    // MD032: docs/CONVENTIONS.md "Doc header" starts the Source files list on the line right after "Source files:".
    "MD032": false,
    // MD038: docs/CONVENTIONS.md quotes the bullet prefix "- NOT COVERED: " with its trailing space.
    "MD038": false,
    // MD041: scripts/check-docs.mjs checks line 1 of every doc; agent.md is a prompt with no title.
    "MD041": false,
    // MD060: table pipe spacing is cosmetic.
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": [".planning/**", ".claude/skills/**", ".claude/CLAUDE.md", "node_modules/**"]
}
